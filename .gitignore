# Build output. The whole workspace shares one, so one rule covers ten crates.
/target/

# `cargo package` and `cargo publish` write here; the tarballs are artefacts of
# a release, not part of one.
**/*.crate

# Backtraces and profiler output.
*.profraw
perf.data*
flamegraph.svg

# Editors and desktop environments. Kept short on purpose: a repository is not
# the place to enumerate everybody's tools, and a global gitignore is.
.vscode/
.idea/
*.swp
.DS_Store

# `cargo release` writes this while it works and removes it afterwards; a
# leftover means a run was interrupted.
Cargo.toml.orig

# Every file in here is written by the tests themselves at run time — the
# suites create the directory and their own fixtures, so a checkout carries
# none of it and `cargo test` never dirties the tree.
/dynamic-config/tests/scratch/

/RELEASE-CHECKLIST.md

# The Python extension's build and tool output. The wheel and the compiled
# module are built by maturin (into `target/` and, for an editable install,
# next to the package); the caches and environments belong to whoever ran
# the tools, not to the repository.

# Build artefacts
dist/
build/
wheels/
*.egg-info/
*.egg
# The compiled extension, wherever an editable install drops it.
*.so
*.pyd
*.dylib
*.py[cod]
**/__pycache__/

# Virtual environments. Named every way people name them, because a
# checkout should not care which one you chose.
.venv/
venv/
env/
.env/
ENV/

# Tool caches and reports
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.benchmarks/
