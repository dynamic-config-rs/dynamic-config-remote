{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo package:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo hack:*)",
      "Bash(cargo run:*)",
      "Bash(rustup:*)",
      "Bash(just:*)",
      "Bash(docker pull:*)",
      "Bash(docker ps:*)"
    ],
    "deny": [
      "Bash(cargo publish:*)",
      "Bash(cargo release:*)",
      "Bash(git push:*)",
      "Read(./**/*.creds)",
      "Read(./**/key.txt)",
      "Read(./**/.env)"
    ]
  }
}
